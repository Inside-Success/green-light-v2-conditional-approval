   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    240,
    0
   ],
   "parameters": {
    "jsCode": "const body = $input.first().json.body || {};\nconst text = (value, max) => String(value ?? '').replace(/[\\u0000-\\u0008\\u000B-\\u001F\\u007F]/g, ' ').trim().slice(0, max);\nconst event = ['generate', 'refine', 'save'].includes(body.event) ? body.event : 'other';\nconst focus = Array.isArray(body.focus_points) ? body.focus_points.map((point) => text(point, 300)).filter(Boolean).slice(0, 5) : [];\nreturn [{\n  json: {\n    event,\n    rep_name: text(body.rep_name, 120),\n    rep_email: text(body.rep_email, 200).toLowerCase(),\n    prospect_name: text(body.prospect_name, 160),\n    show_type: text(body.show_type, 40),\n    input_type: text(body.input_type, 40),\n    focus_points: focus.length ? JSON.stringify(focus) : '',\n    multi_prospect: body.multi_prospect ? 'yes' : 'no',\n    job_id: text(body.job_id, 80),\n    doc_title: text(body.doc_title, 220),\n    document_url: text(body.document_url, 400),\n    detail: text(body.detail, 1000),\n    logged_at: new Date().toISOString(),\n  },\n}];"
   }
  },
